        "id": "41189d17-b36a-469f-9cde-2e942fc8fcfa",
        "name": "Status Is 200",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          528,
          0
        ]
      },
      {
        "parameters": {
          "jsCode": "const response = $input.first()?.json ?? {};\nconst statusCode = Number(response.statusCode ?? 0);\nconst checkedAt = new Date().toISOString();\nconst body = typeof response.body === 'string' ? response.body.slice(0, 500) : JSON.stringify(response.body ?? '');\nreturn [{ json: { statusCode, checkedAt, alertText: `Uptime alert: https://demo-stable.kimai.org/ returned HTTP ${statusCode} at ${checkedAt}.\\n\\nResponse excerpt: ${body}` } }];"
        },
        "id": "65c868f9-c4bf-4291-8c46-06ad799585d9",
        "name": "Format Non-200 Alert",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          784,
          160
        ]
      },
      {
        "parameters": {
          "jsCode": "const error = $input.first()?.json ?? {};\nconst checkedAt = new Date().toISOString();\nreturn [{ json: { checkedAt, alertText: `Uptime alert: https://demo-stable.kimai.org/ could not be checked at ${checkedAt}.\\n\\nError: ${JSON.stringify(error)}` } }];"
        },
        "id": "0e1b7f1e-d210-4e33-936b-5d6854731ff1",
