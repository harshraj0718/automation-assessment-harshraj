                "name": "order",
                "value": "desc"
              },
              {
                "name": "per_page",
                "value": "20"
              }
            ]
          },
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Accept",
                "value": "application/vnd.github+json"
              },
              {
                "name": "X-GitHub-Api-Version",
                "value": "2022-11-28"
              }
            ]
          },
          "options": {
            "timeout": 15000
          }
        },
        "id": "f82958ec-a90b-4819-a1e4-a6452af6307d",
        "name": "Find Popular n8n Repositories",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          240,
          0
        ],
        "retryOnFail": true,
        "maxTries": 2,
        "waitBetweenTries": 1000,
        "onError": "continueErrorOutput"
      },
      {
        "parameters": {
          "jsCode": "const body = $input.first()?.json ?? {};\nconst repos = Array.isArray(body.items) ? body.items : [];\nconst topFive = repos\n  .filter((repo) => repo && repo.full_name && Number.isFinite(repo.stargazers_count))\n  .sort((a, b) => b.stargazers_count - a.stargazers_count)\n  .slice(0, 5);\nif (topFive.length === 0) {\n  throw new Error('GitHub returned no usable repositories for topic:n8n');\n}\nreturn topFive.map((repo) => ({ json: { full_name: repo.full_name, search_stars: repo.stargazers_count } }));"
        },
        "id": "1615c89d-e1f2-43b1-91b4-54c4e57e88aa",
        "name": "Keep Top Five",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          512,
          0
        ],
        "onError": "continueErrorOutput"
      },
      {
        "parameters": {
          "url": "=https://api.github.com/repos/{{ $json.full_name }}",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Accept",
                "value": "application/vnd.github+json"
              },
              {
                "name": "X-GitHub-Api-Version",
                "value": "2022-11-28"
              }
            ]
          },
          "options": {
            "timeout": 15000
          }
        },
        "id": "87d55a7e-9f30-4b8b-af5c-f8f9cb3b57f1",
        "name": "Enrich Repository Details",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          768,
          0
        ],
        "retryOnFail": true,
        "maxTries": 2,
        "waitBetweenTries": 1000,
        "onError": "continueErrorOutput"
      },
      {
        "parameters": {
          "jsCode": "const repos = $input.all().map(({ json: repo }) => ({\n  name: repo.full_name,\n  description: repo.description || 'No description provided',\n  stars: repo.stargazers_count ?? 0,\n  language: repo.language || 'Not specified',\n  url: repo.html_url,\n  updatedAt: repo.updated_at\n})).sort((a, b) => b.stars - a.stars).slice(0, 5);\nif (repos.length === 0) throw new Error('No repository details were returned');\nconst top = repos[0];\nconst lines = repos.map((repo, index) => `${index + 1}. ${repo.name} - ${repo.stars.toLocaleString()} stars (${repo.language})\\n   ${repo.description}\\n   ${repo.url}`);\nconst text = `GitHub morning brief: top ${repos.length} repositories for topic:n8n\\n\\n${lines.join('\\n\\n')}\\n\\nHighest-star result: ${top.stars.toLocaleString()} stars.`;\nreturn [{ json: { repos, topRepository: top, isHighSignal: top.stars >= 1000, emailText: text } }];"
        },
        "id": "5b0768a2-c49b-49fd-bec1-53b0692d5d30",
        "name": "Build Digest",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
